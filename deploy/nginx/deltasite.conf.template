# Delta Energy Solutions — marketing site.
#
# This file is copied byte-for-byte into the Delta-MVP repo. After any
# change here, re-copy it there too, or the two deploys drift apart.
#
# Static files only: no upstream, no proxy_pass. Nothing here touches the
# app stack — frontend, backend, db and onlyoffice keep their own server
# blocks and their own certificate.
#
# The certificate is deliberately its own (`deltasite`) rather than extra
# names added to `delta`. Reissuing a shared certificate to add a name puts
# the working hosts at risk of the same failure; two certificates cannot
# fail together.
#
# Renewal needs no new cron. The certbot container already runs
# `certbot renew --webroot -w /var/www/certbot` every twelve hours, and that
# renews every certificate it holds — provided the acme-challenge location
# below stays above the redirect.

server {
    listen 80;
    listen [::]:80;
    server_name deltaenergysolution.com www.deltaenergysolution.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://deltaenergysolution.com$request_uri;
    }
}

# www -> apex. site.config.js sets the canonical origin to the apex, so every
# canonical tag, og:url and JSON-LD @id on the site names it. Serving the
# same pages on both hosts without this redirect splits the domain in two as
# far as a crawler is concerned.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.deltaenergysolution.com;

    ssl_certificate     /etc/letsencrypt/live/deltasite/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deltasite/privkey.pem;

    return 301 https://deltaenergysolution.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name deltaenergysolution.com;

    ssl_certificate     /etc/letsencrypt/live/deltasite/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deltasite/privkey.pem;

    # `current` is a symlink the deploy pipeline swaps atomically. nginx
    # resolves it per request, so a visitor sees the whole old release or
    # the whole new one, never a mix.
    root /srv/delta-site/current;
    index index.html;

    # scripts/prerender.mjs writes dist/404.html separately from the routed
    # pages — noindex'd, no canonical, no JSON-LD WebPage node — and rsync
    # delivers it to the release root, so it is always there to serve.
    error_page 404 /404.html;

    # Security headers, server level so every response carries them.
    #
    # No includeSubDomains on HSTS: app/api/office live on other hostnames
    # on this same nginx, as a separate application, and must not be forced
    # onto HTTPS by a policy declared here.
    #
    # FOOTGUN: add_header in a location block discards every add_header
    # inherited from the server block, it does not add to them. The
    # location /assets/ and location ~* \.html$ blocks below both already
    # set their own Cache-Control, which would otherwise silently drop
    # these three — so they are repeated in both, not just declared once
    # here.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Routes are prerendered as directories — /about/index.html,
    # /services/residential/index.html and so on. try_files has to reach
    # $uri/index.html BEFORE the SPA fallback, or a direct hit on /about/
    # serves the homepage shell and throws away the prerendered HTML that
    # exists for crawlers in the first place. There is no SPA fallback any
    # more: an unmatched path is a real 404, served by error_page above.
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # A release is whatever rsync delivered; nothing dotted belongs on the
    # web. Declared before the other regex locations so a dotted .html file
    # cannot be matched by the HTML rule first. The ACME location lives on
    # :80, so this cannot shadow it.
    location ~ /\. {
        deny all;
    }

    # Filenames are content-hashed by Vite, so a year is safe. One header,
    # set once: `expires` would emit a second Cache-Control beside this.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        # Repeated: see the FOOTGUN comment above — add_header here replaces
        # the server block's, it does not merge with it.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Never cache the HTML. It carries the canonical tag and the JSON-LD,
    # and a stale copy outlives the next deploy. Reached by internal redirect
    # for prerendered routes too: try_files matches the directory, the index
    # module redirects to its index.html, and this location picks it up.
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
        # Repeated: see the FOOTGUN comment above — add_header here replaces
        # the server block's, it does not merge with it.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json;
}
